# ==========================================
# SmartStock Environment Configuration (.env.example)
# ==========================================

# Backend Server Configuration (server/.env)
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartstock?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_access_key_min_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_long
CLIENT_URL=http://localhost:5173

# Frontend Client Configuration (client/.env)
VITE_API_URL=http://localhost:3000/api/v1
